{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/sodium-native/prebuilds/linux-x64/*"
    }
  }
}
